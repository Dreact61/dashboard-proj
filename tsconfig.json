{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "es6"],
    "jsx": "react-jsx",             // если у тебя JSX/TSX
    "allowJs": true,               // можно смешивать .js и .ts
    "checkJs": false,              // пока не проверяем JS
    "strict": true,                // строгий режим TS
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "outDir": "./dist",            // можно потом настроить под сборку
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "compilerOptions": {
      "baseUrl": "..",
      "paths": {
      "src/*": ["src/*"]
      }
      }
      
      
      
  },
  "include": ["src"]               // если код в папке src
}